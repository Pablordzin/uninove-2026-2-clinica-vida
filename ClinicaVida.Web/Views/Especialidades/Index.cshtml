
@model List<ClinicaVida.Web.Models.Especialidade>

@{
    ViewData["Title"] = "Especialidades";
    var contagem = ViewBag.Contagem as Dictionary<int, int>
        ?? new Dictionary<int, int>();
}

<div class="container mt-4">
    <h1>Especialidades Médicas</h1>
    <p>Confira as especialidades disponíveis e a quantidade de médicos.</p>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Especialidade</th>
                <th>Descrição</th>
                <th>Quantidade de médicos</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var especialidade in Model)
            {
                <tr>
                    <td>@especialidade.Nome</td>
                    <td>@especialidade.Descricao</td>
                    <td>@contagem.GetValueOrDefault(especialidade.Id, 0)</td>
                </tr>
            }
        </tbody>
    </table>

    <a asp-controller="Medicos" asp-action="Index"
       class="btn btn-primary">Ver médicos</a>
</div>
